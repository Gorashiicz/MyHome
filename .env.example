# PostgreSQL
# Lokálně:
DATABASE_URL="postgresql://stavba:stavba@localhost:5432/stavba_pod_kontrolou?schema=public"
# Cloud (Neon) — použijte pooled connection string z Neon dashboardu:
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — vygenerujte: node scripts/generate-auth-secret.mjs
AUTH_SECRET="change-me-to-a-random-secret"

# Veřejná URL aplikace (lokálně / po nasazení na Vercel)
AUTH_URL="http://localhost:3000"

# Supabase Storage (cloud uploady) — lokálně nechte prázdné, soubory jdou do uploads/
# SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# SUPABASE_STORAGE_BUCKET="stavba-uploads"

# Volitelné
NODE_ENV="development"
